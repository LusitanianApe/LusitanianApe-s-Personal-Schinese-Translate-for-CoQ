<Project Sdk="Microsoft.NET.Sdk">
  <!-- =====================================================================
       RuleCheck：离线跑真实规则的测试台（不启动游戏、不进 Unity）

       关键设计：不把 Scripts 编进来，而是反射加载
          mods\_compilecheck\bin\Release\net8.0\QudZhsCookbook.dll
       为什么：游戏程序集里的 ReadOnlySpan / ZString 是 mscorlib 版，
       在 net8.0 下直接引源码会 CS7069；反射加载只解析用得到的方法。
       而且加载的是游戏里同一份 IL，不是复刻，是本体。

       依赖解析：AssemblyLoadContext.Default.Resolving 指向游戏的 Managed 目录。

       用法见 Program.cs 头部注释。
       ===================================================================== -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9</LangVersion>
    <AssemblyName>rulecheck</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0169;CS0649;CS1701;CS1702;NU1701</NoWarn>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\mods\_compilecheck\bin\Release\net8.0\QudZhsCookbook.dll"
          Link="QudZhsCookbook.dll"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\mods\_compilecheck\bin\Release\net8.0\QudZhsCookbook.dll')" />
  </ItemGroup>
</Project>
