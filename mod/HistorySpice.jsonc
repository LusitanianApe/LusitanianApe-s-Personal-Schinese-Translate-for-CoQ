    "gossip": {
      "twoFaction": [
        "=f1=从=f2=那里偷走了=item.a==item.name|strip=。",
        "=f1=把=item.a==item.name|strip=高价卖给了=f2=。",
        "=f1=杀死了=f2=的一位领袖。",
        "=f1=对=f2=的信仰提出了质疑。",
        "=f1=羞辱了=f2=的女眷。",
        "=f1=骗=f2=分了些淡水出来。",
        "=f1=在=f2=的田里撒了盐。",
        "=f1=推翻了=f2=的一条著名定理。",
        "=f1=掘出了=f2=的一些祖先遗骸。",
        "=f1=烧毁了=f2=的一个村庄。",
        "=f1=在掷骰中屡次胜过=f2=。",
        "=f1=把蛇放进了=f2=的营地。",
        "=f1=贬损了=f2=所尊崇的一位著名诗人。",
        "=f1=毒害了=f2=的淡水。",
        "=f1=假冒了=f2=的一位领袖。",
        "=f1=率劫掠队袭击了=f2=的营地。",
        "=f1=给=f2=做了一顿腐坏的饭。",
        "=f1=对=f2=讲了荤笑话。",
        "=f1=燃起烽火警示=f2=的敌人。",
        "=f1=拒绝=f2=进入本地图书馆。",
        "=f1=把=f2=宝库的地图卖给了一名冒险者。",
        "=f1=吃光了=f2=的一批果子。",
        "=f1=改写了=f2=的一台机器人。",
        "=f1=焚毁了=f2=一位领袖的画像。",
        "=f1=给=f2=算了不吉的星象。",
        "=f1=质疑月亮的起源，冒犯了=f2=的信仰。",
        "=f1=赞颂一个高度熵化的存在，冒犯了=f2=。"
      ],
      "leadIns": [
        "你听说了吗？",
        "我听说",
        "有人告诉我",
        "传言说",
        "鸟语啁啾地说"
      ]
    },
