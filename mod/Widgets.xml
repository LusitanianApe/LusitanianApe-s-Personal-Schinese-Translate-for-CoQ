  </object>
  <object Name="PalladiumStrutSpawner" Load="Merge">
    <part Name="Render" DisplayName="钯金支柱" />
  </object>
  <object Name="ArspliceHyphaeSpawner" Load="Merge">
    <part Name="Render" DisplayName="菌丝接合体" />
  </object>
  <object Name="DummyTinkerScreenObject" Load="Merge">
