<?xml version="1.0" encoding="utf-8"?>

<!-- 由 ObjectBlueprints\Widgets.xml 借译生成的 Widgets.xml（Load="Merge" 增量覆盖）。
     译文基准取自 210.20 补丁，机翻痕迹处已优化，译名以我们的术语表为准。

     ★★ 2.16.67：补上 **`Preposition` 字段**（原先整份文件 0 处）。
     病根（用户截图 `去找阿尔吉夫，in他的工作台…或梅赫梅特，bythe水藤丛…`）：
       `XRL.World.Parts.IZoneLandmark::Append()` 把地标名拼成
           Builder.Compound(**Preposition**);   // ← "by" / "in"
           Builder.Compound("the");            // ← 或 Object 的物主代词（他的）
           Builder.Compound(displayName);      // ← 我方已译（水藤丛 / 工作台）
       我们只译了 `DisplayName`、**没抄 `Preposition`** ⇒ 产出 `by the水藤丛`。
     ⚠ 判据（§21/§25）：`Preposition` 是**值**（给人看、可译），不是键。
     映射：`in`→`在`（阿尔吉夫**的工作台**里）· `by`→`旁`（水藤丛**旁**） -->
<objects Load="Merge" Lang="zh-Hans" Encoding="utf-8">
  <object Name="LandmarkJoppaIrudadHut" Load="Merge">
    <part Name="ZoneLandmarkBox" DisplayName="小屋" Preposition="在" />
  </object>
  <object Name="LandmarkJoppaArgyveWorkshop" Load="Merge">
    <part Name="ZoneLandmarkBox" DisplayName="工作台" Preposition="在" />
  </object>
  <object Name="LandmarkJoppaTamTent" Load="Merge">
    <part Name="ZoneLandmarkBox" DisplayName="帐篷" Preposition="在" />
  </object>
  <object Name="LandmarkJoppaWatervine" Load="Merge">
    <part Name="ZoneLandmarkGroup" DisplayName="水藤丛" Preposition="旁" />
  </object>
  <object Name="LandmarkJoppaMill" Load="Merge">
    <part Name="ZoneLandmarkBox" DisplayName="村庄磨坊" Preposition="旁" />
  </object>
  <!-- ★ 2.16.67 新增：官方用 `ZoneLandmarkObject`（另一种部件），我方原先漏了这条 -->
  <object Name="JoppaReshephShrine" Load="Merge">
    <part Name="Render" DisplayName="雷谢夫神龛" />
    <part Name="ZoneLandmarkObject" Preposition="旁" />
  </object>
  <object Name="GritGateMedicalBayWidget" Load="Merge">
    <!-- ★ 2.16.68：补 `Interesting.Preposition`（官方 = "in"）。
         `Interesting.Preposition` 会进 `E.Add(… Preposition …)` ⇒ **参与名字构造**。 -->
    <part Name="Interesting" DisplayName="医疗舱" Preposition="在" />
  </object>
  <object Name="CoralPolypSpawner" Load="Merge">
